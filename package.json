{
  "name": "myhumidor",
  "version": "0.1.0",
  "private": true,
  "description": "MyHumidor by CigarTV — premium cigar rating, collection, and discovery platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:types": "npx supabase gen types typescript --project-id daxizltupchiijrdrtep --schema public > src/types/database.types.ts",
